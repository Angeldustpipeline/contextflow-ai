# Proveedor LLM: codex (por defecto, usa Codex CLI autenticado con ChatGPT) u openai (API con créditos)
LLM_PROVIDER= elegir proveedor

# Codex CLI
CODEX_MODEL= elegir modelo
CODEX_REASONING_EFFORT=low
# Nivel de servicio por defecto sin menú: vacío = estándar, priority = Fast (se elige al iniciar en terminal interactiva)
CODEX_SERVICE_TIER=
# Horas durante las que el contexto se muestra como "Actualizado" (ver sección Contexto del README)
CONTEXT_MAX_AGE_HOURS=12
CODEX_TIMEOUT_SECONDS=30

# Idioma de Whisper: es (por defecto, español fijo) o auto (detección automática)
WHISPER_LANGUAGE=es

# Vocabulario de dominio para mejorar el reconocimiento de Whisper (nombres propios, siglas, jerga técnica).
# Vacío por defecto; ejemplo: "Acme Corp, Proyecto Atlas, OTIF, Power BI, Power Query, SQL, forecast"
WHISPER_INITIAL_PROMPT=

# Detección de voz (VAD): fin de intervención tras este silencio
VAD_SILENCE_MS=800
VAD_PREROLL_MS=300
VAD_MIN_SPEECH_MS=250
VAD_THRESHOLD=0.5
# Respaldo para intervenciones largas (se acumulan, no se consultan por separado)
VAD_MAX_SECONDS=30

# Filtro local previo al LLM (on/off): descarta lo que no muestra señales de pregunta
QUESTION_FILTER=on
# Segundos en que una afirmación filtrada se une a la intervención siguiente (0 = desactivado)
FILTER_MERGE_SECONDS=3

# OpenAI API (proveedor alternativo a Codex CLI)
OPENAI_API_KEY=

# Modelo de respuestas
OPENAI_MODEL= elegir modelo

# Tiempo máximo de espera por solicitud
OPENAI_TIMEOUT_SECONDS=12

# Longitud máxima de respuesta
OPENAI_MAX_OUTPUT_TOKENS=180
